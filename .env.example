# Optional. Already set on the live Cloudflare Worker if /api/recommend reaches Groq.
# Dashboard: Workers & Pages → peptide-protocol → Settings → Variables and Secrets
GROQ_API_KEY=

# Groq retired llama-3.3-70b-versatile on 16 Aug 2026 (free/developer). That 404
# was surfaced live as {"error":"AI error 404"}. Use a current chat model:
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated fallbacks if the primary id 404s again.
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.6-27b
